{
  "enabled": true,
  "name": "Localization Translation Generator",
  "description": "Monitor changes to files containing user-facing text content (such as .json, .yaml, or other localization files) in the primary language. When changes are detected, automatically identify the new or modified text and generate translations for all configured target languages. Ensure translations maintain proper context and meaning while adhering to locale-specific conventions.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.json",
      "**/*.yaml",
      "**/*.yml",
      "**/localization/**/*",
      "**/i18n/**/*",
      "**/translations/**/*",
      "**/locale/**/*",
      "**/lang/**/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A localization file has been modified. Please analyze the changes to identify new or modified text content that requires translation. For any English text or comments found:\n\n1. Identify the primary language content that has been added or changed\n2. Determine the target languages that need translations based on existing locale files or configuration\n3. Generate accurate translations that:\n   - Maintain the original meaning and context\n   - Follow locale-specific conventions (date formats, number formats, cultural considerations)\n   - Preserve any technical terms, brand names, or code-specific terminology\n   - Handle pluralization rules correctly for each target language\n   - Maintain consistent terminology across the application\n\n4. Create or update the corresponding translation files for each target language\n5. Ensure all translation keys are properly structured and match the source file format\n6. Validate that no translation keys are missing or orphaned\n\nPlease provide the translations in the same file structure and format as the source files, and include any necessary locale-specific formatting or cultural adaptations."
  }
}